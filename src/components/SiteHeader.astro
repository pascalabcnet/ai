---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const navItems = [
	{ label: 'С чего начать', href: '/getting-started/installation/' },
	{ label: 'Возможности', href: '/features/' },
	{ label: 'Архитектура', href: '/architecture/' },
];

const showTopNav = false;
const baseUrl = import.meta.env.BASE_URL;
const logoSrc = `${baseUrl}images/ml-matrix-icon.svg`;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<a class="brand" href={baseUrl} aria-label="ML PascalABC.NET">
			<img class="brand-icon" src={logoSrc} alt="" width="120" height="120" />
			<span class="brand-text">
				<span class="brand-ml">ML</span>
				<span class="brand-rest">PascalABC.NET</span>
			</span>
		</a>
	</div>

	{
		showTopNav && (
			<nav class="top-nav" aria-label="Основная навигация">
				{navItems.map((item) => (
					<a href={item.href} class:list={{ active: Astro.url.pathname.startsWith(item.href) }}>
						{item.label}
					</a>
				))}
			</nav>
		)
	}

	<div class="search-wrapper sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			flex: 0 1 auto;
		}

		.brand {
			display: inline-flex;
			align-items: center;
			gap: 0.7rem;
			min-width: 0;
			max-width: 100%;
			color: inherit;
			text-decoration: none;
			white-space: nowrap;
		}

		.brand-icon {
			width: 2.75rem;
			height: 2.75rem;
			flex: 0 0 auto;
		}

		.brand-text {
			display: inline-flex;
			align-items: baseline;
			gap: 0.45rem;
			min-width: 0;
			max-width: 100%;
			overflow: hidden;
			font-size: clamp(1.55rem, 2.6vw, 2.05rem);
			line-height: 1;
			letter-spacing: 0;
		}

		.brand-ml {
			color: #4257f4;
			font-weight: 660;
		}

		.brand-rest {
			color: var(--sl-color-gray-1);
			font-weight: 560;
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.top-nav {
			display: none;
			align-items: center;
			gap: 0.15rem;
			min-width: 0;
		}

		.top-nav a {
			display: inline-flex;
			align-items: center;
			min-height: 2rem;
			padding: 0 0.65rem;
			border-radius: 0.35rem;
			color: var(--sl-color-gray-2);
			font-size: 0.92rem;
			font-weight: 500;
			text-decoration: none;
			white-space: nowrap;
		}

		.top-nav a:hover,
		.top-nav a.active {
			background: var(--sl-color-gray-6);
			color: var(--sl-color-white);
		}

		.search-wrapper {
			justify-content: center;
			flex: 1 1 auto;
			min-width: 10rem;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 64rem) {
			.top-nav {
				display: flex;
			}
		}

		@media (max-width: 50rem) {
			.header {
				max-width: calc(100vw - 5.25rem);
			}

			.brand {
				gap: 0.55rem;
			}

			.brand-icon {
				width: 2.25rem;
				height: 2.25rem;
			}

			.brand-text {
				gap: 0.35rem;
				font-size: clamp(1.35rem, 7.2vw, 1.75rem);
			}

			.search-wrapper {
				display: none;
				min-width: 0;
			}
		}
	}
</style>
